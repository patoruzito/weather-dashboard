---
import CityWeatherCard from "./CityWeatherCard.astro";
import weatherDashboardScript from "../scripts/weather-dashboard.ts?url";

const defaultCityIds = ["bue", "sao", "mex", "mad", "nyc", "tyo"];

const cards = Array.from({ length: 6 }, (_, index) => ({
  id: `card-${index + 1}`,
  index,
  defaultCityId: defaultCityIds[index] ?? "",
}));
---

<section class="weather-dashboard">
  <header class="dashboard-header">
    <h1>Weather Dashboard</h1>
    <p>Pick a city on each card to compare current conditions.</p>
  </header>

  <div class="weather-grid" data-weather-grid>
    {cards.map((card) => (
      <CityWeatherCard
        cardIndex={card.index}
        defaultCityId={card.defaultCityId}
      />
    ))}
  </div>
</section>

<script type="module" src={weatherDashboardScript}></script>
