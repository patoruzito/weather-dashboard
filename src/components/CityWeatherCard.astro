---
import { cities } from "../lib/data/cities";

type Props = {
  cardIndex?: number;
  defaultCityId?: string;
};

const { cardIndex = 0, defaultCityId = "" } = Astro.props;
---

<article class="weather-card" data-city-card data-card-index={cardIndex}>
  <header class="card-header">
    <select class="city-select" data-city-select>
      <option value="">Select city</option>
      {cities.map((city) => (
        <option value={city.id} selected={city.id === defaultCityId}>
          {city.name}, {city.country}
        </option>
      ))}
    </select>
    <div class="badge-group">
      <span class="badge badge-status" data-cache-badge>--</span>
      <span class="badge badge-updated" data-updated-badge>Updated --</span>
    </div>
  </header>

  <div class="card-main">
    <div class="temp" data-temp>--°</div>
    <div class="meta">
      <div class="meta-row">
        <span class="label">Humidity</span>
        <span data-humidity>--%</span>
      </div>
      <div class="meta-row">
        <span class="label">Pressure</span>
        <span data-pressure>---- hPa</span>
      </div>
      <div class="meta-row">
        <span class="label">Local time</span>
        <span data-local-time>--:--</span>
      </div>
      <div class="meta-row">
        <span class="label">Wind</span>
        <span data-wind>-- km/h</span>
      </div>
      <div class="meta-row">
        <span class="label">Condition</span>
        <span data-condition>--</span>
      </div>
      <div class="meta-row meta-row-error" data-error-row hidden>
        <span class="label">Error</span>
        <span data-error-message>--</span>
      </div>
    </div>
  </div>
</article>
